[0.006, "o", "\r\n\u001b[2m# an agent saves what it worked out, in its own words\u001b[0m\r\n"]
[1.403, "o", "\u001b[1m$ mem save \"PAY-18 took production down: the migration held a lock on users for 40s\" --topic deploy-incident\u001b[0m\r\n"]
[0.416, "o", "saved memory 1 in anathem (detected)\r\nTopic «deploy-incident»: there was no active memory under that key, so it was saved as a new one. There are no other topic keys in anathem.\r\n"]
[1.426, "o", "\r\n\u001b[2m# in another session, asked a different way\u001b[0m\r\n"]
[1.402, "o", "\u001b[1m$ mem search \"what took production down\"\u001b[0m\r\n"]
[0.410, "o", " 1. [anathem] PAY-18 took production down: the migration held a lock on users for 40s\r\n    PAY-18 took production down: the migration held a lock on users for 40s\r\n"]
[1.403, "o", "\r\n\u001b[2m# it turns out the cause was something else. corrections are explicit\u001b[0m\r\n"]
[1.403, "o", "\u001b[1m$ mem save \"PAY-18 took production down: it was the index rebuild, not the migration\" --topic deploy-incident\u001b[0m\r\n"]
[0.415, "o", "saved memory 4 in anathem (detected)\r\nTopic «deploy-incident»: replaces memory 1 («PAY-18 took production down: the migration held a lock on users for 40s»), which is left superseded. `mem history 4` shows the chain.\r\n"]
[1.403, "o", "\r\n\u001b[2m# the same question now answers with the correction\u001b[0m\r\n"]
[1.403, "o", "\u001b[1m$ mem search \"what took production down\"\u001b[0m\r\n"]
[0.410, "o", " 1. [anathem] PAY-18 took production down: it was the index rebuild, not the migration\r\n    PAY-18 took production down: it was the index rebuild, not the migration\r\n"]
[1.402, "o", "\r\n\u001b[2m# and the old version is not gone, it just stopped competing\u001b[0m\r\n"]
[1.403, "o", "\u001b[1m$ mem show --topic deploy-incident\u001b[0m\r\n"]
[0.407, "o", "topic: deploy-incident\r\nproject: anathem\r\ncurrent: id:4, saved 2026-11-10 10:43\r\n\r\nPAY-18 took production down: it was the index rebuild, not the migration\r\n\r\nhistory, newest first:\r\n  id:4      2026-11-10 10:43  [active    ]  PAY-18 took production down: it was the index rebuild, not the migration\r\n  id:1      2026-11-10 10:42  [superseded]  PAY-18 took production down: the migration held a lock on users for 40s\r\n"]
[1.404, "o", "\r\n\u001b[2m# no daemon, no network, no API key. one file, and it checks itself\u001b[0m\r\n"]
[1.404, "o", "\u001b[1m$ mem doctor\u001b[0m\r\n"]
[0.415, "o", "  ✓ memories: 3 active, 1 superseded, 0 draft, 0 forgotten\r\n  ✓ FTS5 index in sync (4 of 4 chunks)\r\nAll good.\r\n"]
